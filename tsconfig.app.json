{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "vueCompilerOptions": {
    "plugins": ["vue-router/volar/sfc-typed-router", "vue-router/volar/sfc-route-blocks"]
  },
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "dotdev/theme": ["src/packages/theme"],
      "dotdev/ui-kit": ["src/packages/ui-kit"],
      "dotdev/studio": ["src/packages/studio"],
      "dotdev/icons": ["src/packages/icons"],
    },
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "./typed-router.d.ts",
    "./auto-imports.d.ts",
    "./vite-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ]
}
