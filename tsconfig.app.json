{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "vueCompilerOptions": {
    "plugins": ["vue-router/volar/sfc-typed-router", "vue-router/volar/sfc-route-blocks"]
  },
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "moduleResolution": "Bundler",
    "paths": {
      "dotdev/ui-kit": ["src/packages/ui-kit"],
      "dotdev/studio": ["src/packages/studio"],
      "resolve-docs": ["src/packages/docs/resolve-docs.ts"],
    },
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["./typed-router.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
