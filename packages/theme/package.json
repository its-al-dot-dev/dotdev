{
  "name": "@dotdev/theme",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "dotdev-theme": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --dts --format esm"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "chokidar": "^4.0.3",
    "jiti": "^2.7.0",
    "citty": "^0.2.2",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "tsup": "^8.4.0"
  }
}
