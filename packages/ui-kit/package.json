{
  "name": "@dotdev/ui-kit",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "theme:css": "dotdev-theme css --input ./src/theme/index.ts --output ../../apps/web/src/themes --name default",
    "theme:tokens": "dotdev-theme tokens --input ./src/theme/index.ts --output ../../apps/web/src/themes --name default",
    "theme:css:watch": "dotdev-theme css --input ./src/theme/index.ts --output ../../apps/web/src/themes --name default",
    "theme:tokens:watch": "dotdev-theme tokens --input ./src/theme/index.ts --output ../../apps/web/src/themes --name default"
  },
  "dependencies": {
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "@floating-ui/dom": "^1.8.0",
    "@dotdev/theme": "workspace:*"
  }
}
