{
  "name": "@dotdev/studio",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/utils/extend-route.ts",
    "./style.css": "./src/index.css"
  },
  "scripts": {
    "build:utility": "dotdev-design build -n d -i ./src/theme/index.ts -o ./src/theme/generated/utilities.css -s theme -k utilities",
    "build:vars": "dotdev-design build -n d -i ./src/theme/index.ts -o ./src/theme/generated/vars.css -s theme -k primitives",
    "build:studio": "dotdev-design build -n s -i ./src/theme/index.ts -o ./src/index.css",
    "watch": "dotdev-design watch -d ./src/theme -n s -i ./src/theme/index.ts -o ./src/index.css"
  },
  "dependencies": {
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "pinia": "^4.0.2",
    "shiki": "^4.3.1",
    "vue-component-type-helpers": "^3.3.8",
    "@dotdev/ui-kit": "workspace:*",
    "@dotdev/design": "workspace:*",
    "@dotdev/theme": "workspace:*",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "vite": "^8.1.1",
    "vue-component-meta": "^3.3.8"
  }
}
